static int fl_nodo(int n) { return n > 0 ? n - 1 : 0; }

static int fl_el(int tipo, int a, int b, double val)      /* como ora_el de [67] */
{
    SimEl *e = &sr.el[sr.nel];
    memset(e, 0, sizeof *e);
    e->tipo = (unsigned char)tipo; e->a = (short)a; e->b = (short)b; e->val = val;
    e->k = -1; e->c = e->nref = -1; e->ctl = -1; e->t1 = e->t2 = -1.0;
    return sr.nel++;
}

static int fl_tokens(char *s, char **tk, int max)
{
    int n = 0;
    while (*s && n < max) {
        while (*s == ' ' || *s == '\t' || *s == '\r') s++;
        if (!*s) break;
        tk[n++] = s;
        while (*s && *s != ' ' && *s != '\t' && *s != '\r') s++;
        if (*s) *s++ = 0;
    }
    return n;
}

static int fl_forma(SimEl *e, char **tk, int n)
{
    int i, np;
    if (n < 1) return 0;
    if (!strcmp(tk[0], "DC")) { e->forma = ONDA_CC; np = 1; }
    else if (!strcmp(tk[0], "PUL")) { e->forma = ONDA_PULSO; np = 5; }
    else if (!strcmp(tk[0], "SQR")) { e->forma = ONDA_CUADRADA; np = 4; }
    else if (!strcmp(tk[0], "SIN")) { e->forma = ONDA_SENO; np = 4; }
    else if (!strcmp(tk[0], "TRI")) { e->forma = ONDA_TRIANGULAR; np = 4; }
    else return 0;
    if (n < 1 + np) return 0;
    for (i = 0; i < np; i++) e->p[i] = strtod(tk[1 + i], 0);
    return 1;
}

/* Arma sr y saj; 0 si el texto no es del subconjunto (R V I C L D DZ Q M) */
static int fl_arma_net(const char *net)
{
    const char *s = net;
    char lin[256], *tk[16];
    int n, k, maxn = 0;
    memset(&sr, 0, sizeof sr);
    memset(&saj, 0, sizeof saj);
    sr.ref[0] = 1;
    while (*s) {
        int len = 0;
        while (s[len] && s[len] != '\n') len++;
        if (len > (int)sizeof lin - 1) return 0;
        memcpy(lin, s, (size_t)len);
        lin[len] = 0;
        s += len;
        if (*s) s++;
        n = fl_tokens(lin, tk, 16);
        if (n == 0) continue;
        if (tk[0][0] == '#') {
            if (n == 5 && !strcmp(tk[1], "canal")) {
                int c = atoi(tk[2]) - 1;
                if (c < 0 || c > 1) return 0;
                if (!strcmp(tk[3], "V")) canal(c, CANAL_NODO, fl_nodo(atoi(tk[4])));
                else {
                    for (k = 0; k < sr.nel && strcmp(fl_nom[k], tk[4]) != 0; k++) ;
                    if (k == sr.nel) return 0;
                    canal(c, CANAL_I, k);
                }
            }
            continue;
        }
        if (!strcmp(tk[0], "cesnet")) continue;
        if (!strcmp(tk[0], "tran")) { if (n < 3) return 0; saj.t_fin = strtod(tk[1], 0); continue; }
        if (n < 4 || sr.nel >= MAX_EL) return 0;
        {
            int a = atoi(tk[2]), b = atoi(tk[3]), c = n > 4 ? atoi(tk[4]) : 0, t = -1;
            SimEl *e;
            if (a > maxn) maxn = a;
            if (b > maxn) maxn = b;
            if (!strcmp(tk[0], "R") && n >= 5) t = fl_el(SE_R, fl_nodo(a), fl_nodo(b), strtod(tk[4], 0));
            else if (!strcmp(tk[0], "C") && n >= 5) t = fl_el(SE_C, fl_nodo(a), fl_nodo(b), strtod(tk[4], 0));
            else if (!strcmp(tk[0], "L") && n >= 5) t = fl_el(SE_L, fl_nodo(a), fl_nodo(b), strtod(tk[4], 0));
            else if (!strcmp(tk[0], "V") && n >= 6) {
                t = fl_el(SE_E, fl_nodo(a), fl_nodo(b), strtod(tk[4], 0));
                if (!fl_forma(&sr.el[t], tk + 5, n - 5)) return 0;
            } else if (!strcmp(tk[0], "I")) {
                t = fl_el(SE_J, fl_nodo(a), fl_nodo(b), 0.0);
                if (!fl_forma(&sr.el[t], tk + 4, n - 4)) return 0;
            } else if ((!strcmp(tk[0], "D") && n >= 7) || (!strcmp(tk[0], "DZ") && n >= 9)) {
                t = fl_el(SE_D, fl_nodo(a), fl_nodo(b), 0.0);
                e = &sr.el[t];
                e->modelo = NL_UNION;
                e->m[0] = strtod(tk[4], 0); e->m[1] = strtod(tk[5], 0); e->m[2] = strtod(tk[6], 0);
                if (tk[0][1] == 'Z') { e->m[3] = strtod(tk[7], 0); e->m[4] = strtod(tk[8], 0); }
                e->m[5] = nl_vcrit(e->m[0], e->m[1] * NL_VT);
            } else if (!strcmp(tk[0], "Q") && n >= 10) {    /* Q nom c b e NPN|PNP Is bf br VA */
                if (c > maxn) maxn = c;
                t = fl_el(SE_BJT, fl_nodo(a), fl_nodo(c), 0.0);
                e = &sr.el[t];
                e->c = (short)fl_nodo(b);
                e->modelo = NL_BJT;
                e->pol = (signed char)(!strcmp(tk[5], "NPN") ? 1 : -1);
                e->m[0] = strtod(tk[6], 0); e->m[1] = strtod(tk[7], 0); e->m[2] = strtod(tk[8], 0); e->m[3] = strtod(tk[9], 0);
                e->m[5] = nl_vcrit(e->m[0], NL_VT);
            } else if (!strcmp(tk[0], "M") && n >= 9) {     /* M nom d g s N|P Vt K VA */
                if (c > maxn) maxn = c;
                t = fl_el(SE_MOS, fl_nodo(a), fl_nodo(c), 0.0);
                e = &sr.el[t];
                e->c = (short)fl_nodo(b);
                e->modelo = NL_MOS;
                e->pol = (signed char)(!strcmp(tk[5], "N") ? 1 : -1);
                e->m[0] = strtod(tk[6], 0); e->m[1] = strtod(tk[7], 0); e->m[2] = strtod(tk[8], 0);
            }
            if (t < 0) return 0;
            strncpy(fl_nom[t], tk[1], sizeof fl_nom[t] - 1);
            fl_nom[t][sizeof fl_nom[t] - 1] = 0;
        }
    }
    sr.nn = fl_nodo(maxn) + 1;
    return sr.nel > 0 && saj.t_fin > 0.0;
}

/* ---- Los casos ---- */
static void fl_pulso(int k, double V2, double td, double ancho)
{
    sr.el[k].forma = ONDA_PULSO;
    sr.el[k].p[0] = 0.0; sr.el[k].p[1] = V2; sr.el[k].p[2] = td; sr.el[k].p[3] = ancho; sr.el[k].p[4] = 0.0;
}

/* La red de la biblioteca tiene los valores con que se calculó la exacta */
static int fl_bib_vale(const FlCaso *cs)
{
    const SimRed *s = sim_red();
    const double *p = cs->par;
    int k, nE = 0, nR = 0, nC = 0, nS = 0, ok = 1;
    for (k = 0; k < s->nel; k++) {
        const SimEl *e = &s->el[k];
        if (e->tipo == SE_E) {
            nE++;
            if ((int)p[0] == 10) ok &= e->forma == ONDA_CC && e->p[0] == p[1] && e->val == 0.0;
            else ok &= e->forma == ONDA_CUADRADA && e->p[0] == p[3] && e->p[1] == p[4] && e->p[2] == 50.0 && e->p[3] == p[5] && e->val == 0.0;
        } else if (e->tipo == SE_R) {
            nR++;
            ok &= (int)p[0] == 10 ? (e->val == p[2] && e->val == p[4]) : e->val == p[1];
        } else if (e->tipo == SE_C) {
            nC++;
            ok &= e->val == ((int)p[0] == 10 ? p[3] : p[2]) && e->ci && e->x0 == 0.0;
        } else if (e->tipo == SE_S) {
            nS++;
            ok &= !e->cerrado0 && e->t1 == p[5] && e->t2 == p[6];
        } else ok = 0;
    }
    ok &= nE == 1 && nC == 1 && ((int)p[0] == 10 ? nR == 2 && nS == 1 : nR == 1 && nS == 0);
    ok &= sim_res()->t_fin == ((int)p[0] == 10 ? p[7] : p[6]);
    ok &= strcmp(sim_res()->canal[0].nombre, cs->canales) == 0;
    return ok;
}

/* HAKARU_FLANCO_DIV=n: cada caso (no los de la biblioteca) con su paso / n, para
 * ver que el error baja hacia la exacta (la prueba de las tablas); sin criterios */
static int fl_div = 1;

/* Arma y emula el caso; 0 si no se pudo */
static int fl_emula(const FlCaso *cs)
{
    static Circuito c;
    static Red r;
    const double *p = cs->par;
    int kE, kC, kL, e;
    switch (cs->tipo) {
    case FL_RC:
        sr_init(2);
        kE = sr_el(SE_E, 0, 1, p[0]);
        fl_pulso(kE, p[3], p[4], p[5]);
        kC = sr_el(SE_C, 1, 0, p[1]);
        sr_el(SE_R, 1, 0, p[2]);
        canal(0, CANAL_V, kC); canal(1, CANAL_I, kC);
        saj.t_fin = p[6]; saj.h = p[7];
        break;
    case FL_IMP:                              /* la y+ con impulso (la revisión del arreglo) */
        sr_init(3);
        kE = sr_el(SE_E, 0, 1, 0.0);
        fl_pulso(kE, p[3], p[4], p[5]);
        sr_el(SE_C, 1, 0, 1e-6);
        sr_el(SE_R, 1, 2, p[0]);
        kC = sr_el(SE_C, 2, 0, p[1]);
        sr_el(SE_R, 2, 0, p[2]);
        canal(0, CANAL_V, kC); canal(1, CANAL_I, kC);
        saj.t_fin = p[6]; saj.h = p[7];
        break;
    case FL_RL:
        sr_init(3);
        kE = sr_el(SE_E, 0, 1, 0.0);
        sr.el[kE].forma = ONDA_CUADRADA;
        sr.el[kE].p[0] = p[0]; sr.el[kE].p[1] = p[1]; sr.el[kE].p[2] = 50.0; sr.el[kE].p[3] = p[0];
        sr_el(SE_R, 1, 2, p[2]);
        kL = sr_el(SE_L, 2, 0, p[3]);
        canal(0, CANAL_I, kL); canal(1, CANAL_V, kL);
        saj.t_fin = p[4]; saj.h = p[5];
        break;
    case FL_RLC:
        sr_init(4);
        kE = sr_el(SE_E, 0, 1, 0.0);
        fl_pulso(kE, p[3], p[4], p[5]);
        sr_el(SE_R, 1, 2, p[0]);
        kL = sr_el(SE_L, 2, 3, p[1]);
        kC = sr_el(SE_C, 3, 0, p[2]);
        canal(0, CANAL_V, kC); canal(1, CANAL_I, kL);
        saj.t_fin = p[6]; saj.h = p[7];
        break;
    case FL_BIB:
        modelo_cargar((int)p[0], &c);
        red_extraer(&c, &r);
        sim_ops_reset();
        if (sim_iniciar(&c, &r) != SIM_OK) return 0;
        while (sim_avanzar(SIM_OPS_TICK)) ;
        if (cs->ex.np > 0) {
            pruebas++;
            if (!fl_bib_vale(cs)) { falla(cs->nom, "la red del modelo no es la de la exacta (banco_flanco.py)", 0, 1); return 0; }
        }
        return sim_res()->fin == FIN_COMPLETO;
    case FL_NET:
        if (!fl_arma_net(cs->net)) { falla(cs->nom, "la red CESNET no se entiende", 0, 1); return 0; }
        if (p[0] > 0.0) { saj.h = p[0]; saj.max_pasos = 8L * SIM_MAX_PASOS; }   /* un paso a mano */
        break;
    case FL_ESC: {                            /* como juez_escalera (rev3/juez_flanco/test_juez.inc) */
        int n = (int)p[0], j;
        sr_init(n + 2);
        kE = sr_el(SE_E, 0, 1, p[1]);
        sr.el[kE].forma = ONDA_CUADRADA;
        sr.el[kE].p[0] = 2.5; sr.el[kE].p[1] = p[3]; sr.el[kE].p[2] = 50.0; sr.el[kE].p[3] = 2.5;
        kC = sr_el(SE_C, 1, 0, p[2]);
        for (j = 1; j <= n; j++) {
            sr_el(SE_R, j, j + 1, 1e3);
            sr_el(SE_C, j + 1, 0, 100e-9);
        }
        sr_el(SE_R, n + 1, 0, 10e3);
        canal(0, CANAL_NODO, 1); canal(1, CANAL_I, kC);
        saj.t_fin = p[4]; saj.h = p[5];
        break;
    }
    default:
        return 0;
    }
    if (fl_div > 1) {
        if (!(saj.h > 0.0)) {
            if (sim_emular(&sr, &saj) != SIM_OK) return 0;
            saj.h = sim_res()->h;
        }
        saj.h /= (double)fl_div;
        saj.max_pasos = 8L * SIM_MAX_PASOS;
    }
    sim_ops_reset();
    e = sim_emular(&sr, &saj);
    return e == SIM_OK && sim_res()->fin == FIN_COMPLETO;
}

/* ---- Las medidas ---- */
typedef struct {
    double h, tmin;             /* el paso; la menor tau/h de los flancos             */
    int    nfl, perdidos;       /* flancos (y+) del registro; piezas sin su flanco    */
    double ey[2], ew[2], eo[2]; /* y+, [te, te + 5 tau] y fuera, de la escala         */
    double ty[2], tw[2], to[2]; /* dónde                                              */
    int    nw;                  /* muestras en las ventanas                           */
    long   pasos;
    unsigned long ops;
    unsigned long long huella;
    double bal;                 /* la diferencia del balance / lo entregado           */
} FlMed;

static unsigned long long fl_fnv(unsigned long long h, const void *p, size_t n)
{
    const unsigned char *b = (const unsigned char *)p;
    size_t i;
    for (i = 0; i < n; i++) { h ^= b[i]; h *= 1099511628211ULL; }
    return h;
}

static unsigned long long fl_huella(void)
{
    const SimReg *g = sim_reg();
    const SimRes *r = sim_res();
    size_t n = (size_t)g->n, ne = (size_t)sim_red()->nel;
    unsigned long long h = 14695981039346656037ULL;
    h = fl_fnv(h, &g->n, sizeof g->n);
    h = fl_fnv(h, g->t, n * sizeof g->t[0]);
    h = fl_fnv(h, g->y[0], n * sizeof g->y[0][0]);
    h = fl_fnv(h, g->y[1], n * sizeof g->y[1][0]);
    h = fl_fnv(h, &r->pasos, sizeof r->pasos);
    h = fl_fnv(h, &r->eventos, sizeof r->eventos);
    h = fl_fnv(h, &r->h, sizeof r->h);
    h = fl_fnv(h, &r->t_fin, sizeof r->t_fin);
    h = fl_fnv(h, &r->d.avisos, sizeof r->d.avisos);
    h = fl_fnv(h, r->W, ne * sizeof r->W[0]);
    h = fl_fnv(h, r->Vmax, ne * sizeof r->Vmax[0]);
    h = fl_fnv(h, r->Imax, ne * sizeof r->Imax[0]);
    h = fl_fnv(h, r->Efin, ne * sizeof r->Efin[0]);
    h = fl_fnv(h, r->ultimo.V, ne * sizeof r->ultimo.V[0]);
    h = fl_fnv(h, r->ultimo.I, ne * sizeof r->ultimo.I[0]);
    h = fl_fnv(h, &r->dif_balance, sizeof r->dif_balance);
    h = fl_fnv(h, &r->nw.iter, sizeof r->nw.iter);
    h = fl_fnv(h, &r->nw.sub, sizeof r->nw.sub);
    return h;
}

static void fl_mide(const FlCaso *cs, FlMed *m, int detalle)
{
    const FlExacta *x = &cs->ex;
    const SimReg *g = sim_reg();
    const SimRes *r = sim_res();
    double tol = 1e-9 * r->h, te = -1.0, tfin_ev = te, tau = 0.0;
    int i, ch, k, desde = -1;
    memset(m, 0, sizeof *m);
    m->h = r->h;
    m->tmin = 1e300;
    m->pasos = r->pasos;
    m->huella = fl_huella();
    {                                          /* el balance: lo entregado, como termina() */
        const SimRed *s = sim_red();
        double ent = 0.0;
        for (k = 0; k < s->nel; k++) {
            int t = s->el[k].tipo;
            if (t == SE_E || t == SE_J || t == SE_EC || t == SE_JC || t == SE_AO) ent += r->W[k];
        }
        m->bal = ent != 0.0 ? r->dif_balance / fabs(ent) : r->dif_balance;
    }
    if (x->np == 0) {                          /* sin exacta: los flancos y la tau de los modos del motor */
        for (i = 1; i < g->n; i++) m->nfl += g->t[i] == g->t[i - 1];
        m->tmin = r->tau_min > 0.0 ? r->tau_min / r->h : 1e300;
        return;
    }
    for (i = 0; i < g->n; i++) {
        /* en un evento el registro lleva te- y luego te+ con el mismo t: el primero
         * del grupo es el límite por la izquierda; el que le sigue, la y+ */
        int mas = i > 0 && g->t[i - 1] == g->t[i], izq = !mas && i + 1 < g->n && g->t[i + 1] == g->t[i], ven;
        double t = g->t[i];
        /* una tabulada (el oráculo) empieza en t = 0: el punto de operación
         * (0⁻, cuando en 0 hay un flanco) no tiene exacta */
        if (izq && t <= 0.0 && x->p[0].nm < 0 && x->p[0].ta <= 0.0) continue;
        if (mas) {                             /* la y+ de un flanco */
            const FlPieza *p = &x->p[fl_pieza(x, t, 1, tol)];
            te = t; tau = p->tau; desde = i;
            tfin_ev = te + 5.0 * tau;
            m->nfl++;
            if (tau / r->h < m->tmin) m->tmin = tau / r->h;
        }
        ven = !mas && te >= 0.0 && t > te && t <= tfin_ev + tol;
        if (ven) m->nw++;
        for (ch = 0; ch < 2; ch++) {
            double esc = x->esc[ch], e;
            if (!(esc > 0.0)) continue;
            e = fabs(g->y[ch][i] - fl_exacta(x, ch, t, izq ? -1 : 1, tol)) / esc;
            if (mas) { if (e > m->ey[ch]) { m->ey[ch] = e; m->ty[ch] = t; } }
            else if (ven) { if (e > m->ew[ch]) { m->ew[ch] = e; m->tw[ch] = t; } }
            else if (e > m->eo[ch]) { m->eo[ch] = e; m->to[ch] = t; }
        }
        if (detalle && desde >= 0 && i >= desde && i <= desde + 4) {
            if (i == desde) printf("      flanco en %.9g (tau/h %.3g):", te, tau / r->h);
            else printf("      %+10.4g h:", (t - te) / r->h);
            for (ch = 0; ch < 2; ch++) {
                double ex;
                if (!(x->esc[ch] > 0.0)) continue;
                ex = fl_exacta(x, ch, t, 1, tol);
                printf("  y%d %.8g (exacta %.8g; %.1e)", ch + 1, g->y[ch][i], ex, fabs(g->y[ch][i] - ex) / x->esc[ch]);
            }
            printf("\n");
        }
    }
    /* cada pieza de la exacta que empieza en (0, t_fin) tiene su flanco en el registro */
    for (k = 0; k < x->np; k++) {
        double ta = x->p[k].ta;
        int hay = 0;
        if (!(ta > 0.0) || ta >= r->t_fin - tol) continue;
        for (i = 1; i < g->n && !hay; i++) hay = g->t[i] == g->t[i - 1] && fabs(g->t[i] - ta) <= tol;
        if (!hay) m->perdidos++;
    }
    if (m->nfl == 0) m->tmin = 0.0;
}

static void fl_nombre_canal(const FlCaso *cs, int ch, char *buf, int cap)
{
    const char *s = cs->canales, *c = strchr(s, ',');
    int n;
    if (ch == 0) n = c ? (int)(c - s) : (int)strlen(s);
    else { if (!c) { buf[0] = 0; return; } s = c + 2; n = (int)strlen(s); }
    if (n > cap - 1) n = cap - 1;
    memcpy(buf, s, (size_t)n);
    buf[n] = 0;
}

/* Los números del hallazgo: la exacta del caso mínimo (a 1e-4) */
static void fl_exacta_vale(void)
{
    const FlExacta *x = &FL_CASOS[0].ex;
    double tol = 1e-9 * 5e-6;
    chk_t("banco del flanco", "exacta: V(C) en 6 ms+ = 4,9505", fl_exacta(x, 0, 6e-3, 1, tol), 4.9505, 5.0, 2e-5);
    chk_t("banco del flanco", "exacta: I(C) en 6 ms+ = -0,5", fl_exacta(x, 1, 6e-3, 1, tol), -0.5, 0.5, 1e-12);
    chk_t("banco del flanco", "exacta: V(C) en 6 ms- = 4,9505", fl_exacta(x, 0, 6e-3, -1, tol), 4.9505, 5.0, 2e-5);
    chk_t("banco del flanco", "exacta: I(C) en 6 ms- = 0", fl_exacta(x, 1, 6e-3, -1, tol), 0.0, 0.5, 1e-12);
    chk_t("banco del flanco", "exacta: V(C) en 6,0025 ms = 0,91957", fl_exacta(x, 0, 6.0025e-3, 1, tol), 0.91957, 5.0, 2e-6);
    chk_t("banco del flanco", "exacta: V(C) en 6,010 ms = 0,0059", fl_exacta(x, 0, 6.010e-3, 1, tol), 0.0059, 5.0, 2e-5);
}

/* ---- La revisión del arreglo (rev4/rev_flanco): lo que el banco no ve ----
 * El costo de la presonda y de los tramos que decide (en la estimación de los
 * 2 s y en los topes), el bucle de elige_paso (un h a mano, una ventana
 * pedida) y el balance con muchos flancos. Las redes, las de los casos de la
 * revisión (rev_flanco/res/test_revf.inc): E cuadrada 0/5 V, R1, un 1N4148,
 * C y R4 en paralelo; V(C) e I(C). «Lo real» es el modelo de la revisión:
 * operaciones·SIM_NS_OP + pasos·SIM_NS_PASO + iteraciones de Newton (con las
 * de la presonda)·NS_ITER, con lo medido en la calculadora sin el USB
 * (0,46329 µs, 43,45 µs y 214,3 µs; con el USB, 0,6337, 73,8 y 250,5; antes
 * 0,63, 20 y 15, a ojo). */
static void fl_diodo_c(double f, double t_fin, double h, double R1, double C, double R4)
{
    int kE, kD, kC;
    sr_init(4);
    kE = sr_el(SE_E, 0, 1, 0.0);
    sr.el[kE].forma = ONDA_CUADRADA;
    sr.el[kE].p[0] = 2.5; sr.el[kE].p[1] = f; sr.el[kE].p[2] = 50.0; sr.el[kE].p[3] = 2.5;
    sr_el(SE_R, 1, 2, R1);
    kD = sr_el(SE_D, 2, 3, 0.0);
    sr.el[kD].modelo = NL_UNION; sr.el[kD].c = sr.el[kD].nref = -1; sr.el[kD].ctl = -1;
    sr.el[kD].m[0] = 2.52e-9; sr.el[kD].m[1] = 1.752; sr.el[kD].m[2] = 0.568;
    sr.el[kD].m[5] = nl_vcrit(sr.el[kD].m[0], sr.el[kD].m[1] * NL_VT);
    kC = sr_el(SE_C, 3, 0, C);
    sr_el(SE_R, 3, 0, R4);
    canal(0, CANAL_NODO, 3); canal(1, CANAL_I, kC);
    saj.t_fin = t_fin; saj.h = h;
}

static double fl_real(void)
{
    const SimRes *r = sim_res();
    return (double)sim_ops() * SIM_NS_OP * 1e-9 + (double)r->pasos * SIM_NS_PASO * 1e-9 + (double)(r->nw.iter + r->nw.sonda) * NS_ITER * 1e-9;
}

static void test_flanco_rev(void)
{
    const SimRes *r;
    double real, C = 150e-9, R = 1e3, h = 5e-6, x = 0.05, rp, rint, ent, ex;
    int kE, kC, kR;
    printf("  la revisión del arreglo: costo y topes del tramo, el bucle del paso y el balance\n");

    /* 1. Un diodo que carga 1 nF por 100 ohm con 100 k de carga (la red no es
     *    rígida: τ = 100 µs; al conducir, 0,1 µs), 20 kHz, 10 ms, paso
     *    automático: los tramos de las subidas (la presonda los decide a
     *    priori) cuentan en los 2 s. Con la sonda en cada evento, 200 tramos
     *    fuera de la estimación: 4,4 s reales con 1,95 estimados (la base,
     *    2,8 s) */
    fl_diodo_c(20e3, 10e-3, 0.0, 100.0, 1e-9, 100e3);
    sim_ops_reset();
    emula("revisión: diodo C 100k, 20 kHz");
    r = sim_res();
    real = fl_real();
    printf("    diodo C 100k, 20 kHz: h %.4g, t_fin %.4g, %ld pasos, %d eventos, %d tramos, estimado %.2f s, real %.2f s\n",
           r->h, r->t_fin, r->pasos, r->eventos, r->tramos, r->t_est, real);
    chk_cond("revisión: diodo C 100k, 20 kHz", "acaba", r->fin == FIN_COMPLETO);
    chk_cond("revisión: diodo C 100k, 20 kHz", "un tramo en cada subida (la clase de la subida), ninguno en las bajadas",
             2 * r->tramos == r->eventos);
    /* Con lo medido en la calculadora cada iteración pesa 214,3 µs (antes
     * 15) y esta red (el diodo carga 1 nF por 100 ohm) da ~4 iteraciones por
     * paso, el doble de las 2 que cuenta elige_paso: 1,99 s a priori y 2,46
     * de verdad (con el banco del USB, 2,66 con 1,95). El control del gasto,
     * cada segundo, corrige lo estimado con el ritmo que ve (2,49 s): no pasa
     * de los 3 en que acortaría la ventana */
    chk_cond("revisión: diodo C 100k, 20 kHz", "lo real <= 3 s, y <= 1,4 veces lo estimado",
             real <= 3.0 && real <= 1.4 * r->t_est);

    /* 2. El tope de pasos con h a mano: la misma red a 10 kHz, 26 ms, h = 2 µs.
     *    La base acaba con 19 501 pasos; con la sonda, FIN_TOPE (20 000 pasos
     *    en 513 de 520 eventos): los tramos no contaban en el tope */
    fl_diodo_c(10e3, 26e-3, 2e-6, 100.0, 1e-9, 100e3);
    emula("revisión: diodo C 100k, h a mano");
    r = sim_res();
    printf("    diodo C 100k, 10 kHz, 26 ms, h = 2 us a mano: h %.4g, %ld pasos, %d tramos, fin %d\n", r->h, r->pasos, r->tramos,
           r->fin);
    chk_cond("revisión: diodo C 100k, h a mano", "acaba, con el h pedido", r->fin == FIN_COMPLETO && r->h == 2e-6);

    /* 3. El bucle de elige_paso con h a mano: 10 k de carga (τ = 9,99 µs: con
     *    h = 2 µs, rígida por muy poco), 30 ms. Antes el tope (32 subpasos
     *    por evento) llevaba h a 50 µs (25 veces); ahora sube lo justo */
    fl_diodo_c(10e3, 30e-3, 2e-6, 100.0, 1e-9, 10e3);
    emula("revisión: diodo C 10k, h a mano");
    r = sim_res();
    printf("    diodo C 10k, 10 kHz, 30 ms, h = 2 us a mano: h %.4g (x%.1f), %ld pasos, fin %d\n", r->h, r->h / 2e-6, r->pasos, r->fin);
    chk_cond("revisión: diodo C 10k, h a mano", "acaba, y h como mucho 6 veces el pedido", r->fin == FIN_COMPLETO && r->h <= 6.0 * 2e-6);

    /* 4. El bucle con la ventana pedida: el diodo NR (2 k, 100 nF, 10 k; τ al
     *    conducir 167 µs) con 1 kHz y 300 ms pedidos. Al crecer h cruzaba el
     *    umbral del tramo, el costo saltaba y la ventana bajaba a 20 ms; ahora
     *    se queda en la mayor que cabe sin tramo. Con el costo medido en la
     *    calculadora sin el USB (2026-09-27: ~1,1 ms por paso con suaves y la
     *    ventana de medida; con el USB, 0,88; antes, 0,36) esa es la de 50
     *    ms: la de 100 ms no cabe sin tramo (con h = 31,25 µs a mano, el mayor
     *    sin él, se estima en ~3,4 s a priori, 3,6 de verdad; con el USB
     *    quedaba la de 20 ms y la de 50 no cabía; antes, la de 100). Se
     *    comprueban las dos cosas */
    fl_diodo_c(1e3, 300e-3, 0.0, 2e3, 100e-9, 10e3);
    emula("revisión: diodo NR, 300 ms");
    r = sim_res();
    printf("    diodo NR, 1 kHz, 300 ms pedidos: t_fin %.4g, h %.4g, %d tramos\n", r->t_fin, r->h, r->tramos);
    chk_cond("revisión: diodo NR, 300 ms", "la ventana, 50 ms o más, sin tramos", r->t_fin >= 0.05 - 1e-12 && r->tramos == 0);
    fl_diodo_c(1e3, 100e-3, 31.25e-6, 2e3, 100e-9, 10e3);
    emula("revisión: diodo NR, 100 ms a mano");
    r = sim_res();
    printf("    diodo NR, 100 ms y h = 31,25 us a mano: %d tramos, estimado %.2f s\n", r->tramos, r->t_est);
    chk_cond("revisión: diodo NR, 300 ms", "la de 100 ms no cabe ni con el mayor h sin tramo", r->tramos == 0 && r->t_est > 2.0);

    /* 5. El balance con muchos flancos y τ del orden de h/16: RC con r interna
     *    (τ = 0,25 µs), cuadrada de 76,9 kHz, h = 3,25 µs, 47 flancos en
     *    0,3 ms. La entregada exacta (energia_rc.py de la revisión: ∫V²/R +
     *    ΔE(C)), 5,398508e-6 J; con los productos por los pesos de las etapas,
     *    2,56e-6 J y la diferencia del balance, −53 % */
    rp = x * h / C; rint = 1.0 / (1.0 / rp - 1.0 / R);
    sr_init(2);
    kE = sr_el(SE_E, 0, 1, rint);
    sr.el[kE].forma = ONDA_CUADRADA;
    sr.el[kE].p[0] = 2.5; sr.el[kE].p[1] = 1.0 / (2.6 * h); sr.el[kE].p[2] = 50.0; sr.el[kE].p[3] = 2.5;
    kC = sr_el(SE_C, 1, 0, C);
    kR = sr_el(SE_R, 1, 0, R);
    canal(0, CANAL_NODO, 1); canal(1, CANAL_I, kC);
    saj.t_fin = 0.3e-3; saj.h = h;
    emula("revisión: balance con 47 flancos");
    r = sim_res();
    ent = r->W[kE]; ex = 5.398508e-6;
    printf("    RC con 47 flancos de tau = h/13: entregada %.6e J (exacta %.6e), W(R) %.6e, diferencia %.3e J\n", ent, ex, r->W[kR],
           r->dif_balance);
    chk_cond("revisión: balance con 47 flancos", "la entregada a 1e-3 de la exacta y la diferencia a 1e-4",
             fabs(ent - ex) <= 1e-3 * ex && fabs(r->dif_balance) <= 1e-4 * ex);
}

static void test_flanco(void)
{
    static FlMed med[FL_NCASOS];
    const char *solo = getenv("HAKARU_FLANCO_CASO");
    int detalle = getenv("HAKARU_FLANCO_DETALLE") != 0, hoy = getenv("HAKARU_FLANCO_HOY") != 0, hay_hoy = FL_HOY[0].pasos > 0;
    int i, ch, nfil, n_r = 0, n_r_ok = 0, n_nr = 0, n_nr_ok = 0;

    fl_div =getenv("HAKARU_FLANCO_DIV") ? atoi(getenv("HAKARU_FLANCO_DIV")) : 1;
    if (fl_div < 1) fl_div = 1;
    printf("[68] El banco del arranque tras un flanco (criterios: rígido si tau < %.3g" "h; y+ <= %.0e, tras <= %.0e, "
           "costo <= x%.2g; si no, bit a bit)\n", FL_RIGIDO, FL_TOL_YMAS, FL_TOL_TRAS, FL_COSTO);
    if (fl_div > 1) { printf("  HAKARU_FLANCO_DIV: cada caso con h/%d (sin la biblioteca y sin criterios)\n", fl_div); hay_hoy = 0; hoy = 0; }
    fl_exacta_vale();
    printf("  %-16s %-8s %-9s %-8s %-3s %-8s %-8s %-8s %-15s %-17s %-8s %-9s %s\n", "caso", "canal", "h", "tau/h", "fl",
           "e(y+)", "e[5tau]", "e(fuera)", "pasos", "operaciones", "huella", "bal", "criterios");
    for (i = 0; i < FL_NCASOS; i++) {
        const FlCaso *cs = &FL_CASOS[i];
        const FlHoy *b = &FL_HOY[i];
        FlMed *m = &med[i];
        char nc[16], ver[64];
        int rigido, ok = 1, k;
        if (solo && !strstr(cs->nom, solo)) continue;
        if (fl_div > 1 && cs->tipo == FL_BIB) continue;
        if (detalle) printf("  -- %s\n", cs->nom);
        pruebas++;
        if (!fl_emula(cs)) {
            char msg[200];
            sim_mensaje(sim_red(), &sim_res()->d, msg, sizeof msg);
            falla(cs->nom, msg, sim_res()->d.estado, SIM_OK);
            continue;
        }
        {
            unsigned long ops = sim_ops();          /* de sim_iniciar al final (fl_emula pone el contador a 0) */
            fl_mide(cs, m, detalle);
            m->ops = ops;
        }
        rigido = m->tmin < FL_RIGIDO;
        chk_cond(cs->nom, "cada flanco de la exacta está en el registro", m->perdidos == 0);
        ver[0] = 0;
        for (ch = 0; ch < 2; ch++) {
            if (!(cs->ex.esc[ch] > 0.0)) continue;
            if (rigido) {
                if (!(m->ey[ch] <= FL_TOL_YMAS) && !strstr(ver, "y+")) strcat(ver, " y+");
                if (!(m->ew[ch] <= FL_TOL_TRAS && m->eo[ch] <= FL_TOL_TRAS) && !strstr(ver, "tras")) strcat(ver, " tras");
            }
        }
        for (k = 0; k < FL_NBAL; k++)
            if (!strcmp(cs->nom, FL_BAL_CASOS[k]) && !(fabs(m->bal) <= FL_TOL_BAL)) strcat(ver, " balance");
        if (hay_hoy && b->pasos > 0) {
            if (rigido) {
                double cmax = strcmp(cs->nom, "diodo C z4.5") ? FL_COSTO : FL_COSTO_Z;
                if ((double)m->pasos > cmax * (double)b->pasos || (double)m->ops > cmax * (double)b->ops) strcat(ver, " costo");
            } else {
                if (m->huella != b->huella) strcat(ver, " bit");
                if ((double)m->ops > FL_COSTO_NR * (double)b->ops) strcat(ver, " costo");
            }
        }
        if (fl_div > 1) strcpy(ver, " (h/n)");
        ok = ver[0] == 0;
        if (fl_div == 1) {
            char msg[96];
            sprintf(msg, "no cumple (%s):%s", rigido ? "rígido" : "no rígido", ver);
            pruebas++;
            if (!ok) falla(cs->nom, msg, 0, 1);
        }
        if (rigido) { n_r++; n_r_ok += ok; } else { n_nr++; n_nr_ok += ok; }
        for (ch = 0, nfil = 0; ch < 2; ch++) {
            char sp[24], so[24], sy[24], sf[24], sh[12], sb[16];
            if (cs->ex.np > 0) {                  /* con exacta: una línea por canal medido */
                if (!(cs->ex.esc[ch] > 0.0)) continue;
                fl_nombre_canal(cs, ch, nc, sizeof nc);
                sprintf(sy, "%.1e", m->ey[ch]);
                if (m->nw > 0) sprintf(so, "%.1e", m->ew[ch]); else strcpy(so, "-");
                sprintf(sf, "%.1e", m->eo[ch]);
            } else {                              /* sin exacta: solo la huella y el costo */
                if (ch == 1) break;
                strcpy(nc, "-");
                strcpy(sy, "-"); strcpy(so, "-"); strcpy(sf, "-");
            }
            if (nfil++ == 0) {
                int con_hoy = hay_hoy && b->pasos > 0;
                sprintf(sp, "%ld x%.2f", m->pasos, con_hoy ? (double)m->pasos / (double)b->pasos : 1.0);
                sprintf(sh, "%s", !con_hoy ? "?" : m->huella == b->huella ? "=" : "distinta");
                sprintf(sb, "%.1e", m->bal);
                printf("  %-16s %-8s %-9.3g %-8.3g %-3d %-8s %-8s %-8s %-15s %-8lu x%-7.2f %-8s %-9s %s%s\n", cs->nom, nc, m->h,
                       m->tmin, m->nfl, sy, so, sf, sp, m->ops, con_hoy ? (double)m->ops / (double)b->ops : 1.0, sh, sb,
                       rigido ? "rígido: " : "no rígido: ", ok ? "OK" : ver + 1);
            } else
                printf("  %-16s %-8s %-9s %-8s %-3s %-8s %-8s %-8s\n", "", nc, "", "", "", sy, so, sf);
            if (detalle && cs->ex.np > 0)
                printf("  %-16s          (dónde: y+ %.6g, [5tau] %.6g, fuera %.6g; %d muestras en las ventanas)\n", "", m->ty[ch],
                       m->tw[ch], m->to[ch], m->nw);
        }
    }
    printf("  rígidos que cumplen: %d de %d; no rígidos bit a bit: %d de %d%s\n", n_r_ok, n_r, n_nr_ok, n_nr,
           hay_hoy ? "" : " (sin línea base: FL_HOY vacía)");
    if (hoy) {
        printf("  /* la línea base (HAKARU_FLANCO_HOY): huella, pasos, operaciones */\n");
        for (i = 0; i < FL_NCASOS; i++)
            printf("    { 0x%016llxULL, %ld, %luUL },   /* %s */\n", med[i].huella, med[i].pasos, med[i].ops, FL_CASOS[i].nom);
    }
    /* la y+ con impulso: el estado de un C que no salta es el de te- con un
     * error O(ε²) (con los tres Euler de ε de antes, ε·i/C: 1e-3 de la escala) */
    for (i = 0; i < FL_NCASOS && fl_div == 1; i++)
        if (!strcmp(FL_CASOS[i].nom, "imp C") && med[i].nfl > 0)          /* si se corrió */
            chk_cond("imp C", "la y+ de V(C2) e I(C2) a 1e-5 de la escala (el impulso no mueve C2)",
                     med[i].ey[0] <= 1e-5 && med[i].ey[1] <= 1e-5);
    if (!solo && fl_div == 1 && !hoy) test_flanco_rev();
}
