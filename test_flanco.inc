/* --------------------------------------------------------------------------
 *  68. El banco del arranque tras un flanco (HAKARU_SOLO_FLANCO=1)
 *
 *  El hallazgo (del oráculo no lineal [67], caso_204): tras un flanco, un
 *  modo más rápido que el paso (tau del orden de h o menor) sale con el error
 *  de primer orden del arranque de Euler (8 pasos de h/8) y el trapecio lo
 *  arrastra con rho = (1 - h/2tau)/(1 + h/2tau) por paso (-> -1 si tau << h).
 *  El §17.3 solo admite que la y+ de te+ sea aproximada; lo de después no es
 *  correcto. Este banco lo mide, para los arreglos, en casos con solución
 *  exacta conocida:
 *    1. el caso mínimo del hallazgo: E de pulso con r = 10 ohm (0 -> 5 V en 2 ms,
 *       vuelve a 0 en 6 ms), C = 150 nF y R = 1 k en paralelo, t_fin 10 ms, paso
 *       automático (5 us; el modo, 1,49 us, no lo mira);
 *    2. el mismo RC con h = 5 us a mano y tau/h = 0,01; 0,1; 0,3; 1; 3 y 10
 *       (la r interna);
 *    3. una RL rígida con una cuadrada (0/10 V, 1 kHz; tau = 0,5 us, h 2,5 us);
 *    4. un RLC serie rígido (un modo de 0,25 us con h 1 us y otro de 100 us)
 *       y uno no rígido (el subamortiguado de la biblioteca, con un pulso);
 *    5. redes NO rígidas de la biblioteca, que con cualquier arreglo deben
 *       quedar BIT A BIT iguales: el integrador y el derivador RC con su
 *       cuadrada (200 y 10 flancos, tau/h 500 y 10) y el interruptor que
 *       cierra y abre (con exacta), y el derivador con AO y el astable con AO
 *       (no lineales, tau/h 40 y 100; sin exacta: solo la huella y el costo);
 *    6. no lineales: un diodo (1N4148) que carga un C de 1 nF con un pulso
 *       (el modo rígido, 0,1 us, solo existe mientras conduce: el punto de
 *       operación tiene el diodo en corte y sus modos no lo ven), y el caso_204
 *       del oráculo (un BJT saturado con C17 en el colector: modo de 6,2 y
 *       10,9 us, paso automático 23 us por el tope de 2 s) con ese paso y con
 *       11,5 y 5,75 us fijos (h/2 y h/4);
 *    7. la uniformidad (las escaleras del juez, rev3/juez_flanco): una E
 *       cuadrada de 1 kHz con r interna, un C0 de 150 nF a la entrada y 14 u 8
 *       tramos RC (1 k, 100 nF) con carga de 10 k; 20 flancos en 10 ms, paso
 *       automático, tau/h 0,06 (r = 1 ohm) y 0,55 (r = 10 ohm). El criterio va
 *       en TODOS los flancos (un arreglo con presupuesto dejaba sin arreglar
 *       los últimos);
 *    8. lo que añadió la revisión del arreglo (rev4/rev_flanco), al final:
 *       el RC con tau/h = 6 (no rígido: la banda de 5h a 7,5h, donde el
 *       arranque de Euler deja 1,5e-3 y el tramo no actúa, se ve en la
 *       tabla), «imp C» (un C1 de 1 uF sobre la E ideal: impulso en cada
 *       flanco; la y+ de C2, a 1e-5), el «diodo NR» (tau al conducir 33h: no
 *       rígido, bit a bit y sin costo) y el «diodo C z4.5» (100 k de carga,
 *       10 kHz, h = 1/140000 s a mano: z = 4,5 en el primer subpaso del
 *       tramo; la segunda etapa de SDIRK2 sobrecargaba el C y el diodo, al
 *       cortarse, lo dejaba así: 0,24 de la escala). Detrás de la tabla,
 *       test_flanco_rev: la estimación y los topes con la presonda, el bucle
 *       del paso (h a mano, ventana pedida) y el balance con 47 flancos.
 *  Las exactas las escribe herramientas/banco_flanco.py en las TABLAS de
 *  abajo: las lineales, analíticas (mpmath, la suma de modos de cada pieza:
 *  se evalúan exactas en cualquier instante, también en los que añada un
 *  arreglo); las no lineales, el oráculo no lineal (su copia en herramientas/,
 *  Radau con rtol 1e-12, partido en los flancos) en una tabla densa por pieza
 *  con cúbica de 4 puntos (a 1e-9 de la escala; la y+ de cada pieza es el
 *  algebraico en te+ con el estado de te-, exacta).
 *
 *  Medidas por caso y canal, relativas a la escala (máx |y| de la exacta):
 *    e(y+)    el peor error de la y+ (la segunda muestra con t = te);
 *    e[5tau]  el peor de las muestras con te < t <= te + 5·tau (tau: el modo
 *             más rápido de la pieza que empieza en te), sin la y+;
 *    e(fuera) el peor de todas las demás (sin las y+);
 *    tau/h    la menor de los flancos (con el h de la corrida);
 *    pasos (res->pasos) y operaciones (sim_ops(), de sim_iniciar al final),
 *    y la huella FNV-1a del registro y de los resultados (bit a bit), frente a
 *    la línea base FL_HOY (el motor de rev2/base).
 *  Los criterios de un arreglo (FL_RIGIDO, FL_TOL_*, FL_COSTO*, abajo) se
 *  comprueban y cuentan como fallos. Con el motor de rev2/rev4 (el arranque
 *  de Euler, FL_HOY) fallaban los 16 rígidos y pasaban los 9 no rígidos; con
 *  el tramo rígido (§17.3) pasan todos. Además, el balance de energía
 *  (diferencia / entregada, columna «bal»): el del mínimo, la RL, el RC de
 *  tau = h/100 y la escalera de r = 1 ohm, a FL_TOL_BAL (las integrales del
 *  tramo, rq_suma).
 *
 *  Variables: HAKARU_FLANCO_DETALLE=1 (cada flanco: la y+ y las 4 muestras
 *  siguientes frente a la exacta, y dónde cae cada peor error);
 *  HAKARU_FLANCO_CASO=texto (solo los casos cuyo nombre lo contiene);
 *  HAKARU_FLANCO_DIV=n (cada caso salvo la biblioteca con su paso / n, sin
 *  criterios: el error tiene que bajar hacia la exacta; con n = 10 el mínimo
 *  da lo mismo que «RC tau/h=3»); HAKARU_FLANCO_HOY=1 (escribe la línea base
 *  FL_HOY de la corrida, para pegarla abajo si cambia el motor de referencia
 *  o la lista de casos).
 *
 *  Se incluye en host_test.c (usa sr, saj, sr_init, sr_el, canal, pruebas,
 *  falla, chk_t y chk_cond); corre en la batería, en HAKARU_SOLO_E4 y solo, con
 *  HAKARU_SOLO_FLANCO=1.
 * ----------------------------------------------------------------------- */
#include "nolin.h"

enum { FL_RC = 0, FL_RL, FL_RLC, FL_BIB, FL_NET, FL_ESC, FL_IMP };

/* Una pieza de la exacta: desde ta hasta la siguiente. Lineal (nm >= 0):
 *   y = c0 + suma_k e^(re_k·u)·(A_k·cos(im_k·u) + B_k·sin(im_k·u)), u = t - ta;
 * tabulada (nm = -1): los puntos pt[i0 .. i0+np-1] (t, y1, y2). tau: el modo
 * más rápido al empezar la pieza (0 en la de antes de t = 0). Hasta FL_MMAX
 * modos (las escaleras: 15). */
#define FL_MMAX 16
typedef struct {
    double ta, tau;
    int    nm;
    double re[FL_MMAX], im[FL_MMAX];
    double c0[2];
    double A[2][FL_MMAX], B[2][FL_MMAX]; /* [canal][modo] */
    int    i0, np;
} FlPieza;

typedef struct {
    int np;
    const FlPieza *p;
    const double (*pt)[3];              /* las tabuladas, o NULL */
    double esc[2];                      /* máx |y| de la exacta; 0 = el canal no se mide */
} FlExacta;

/* par[] según el tipo:
 *   FL_RC   r, C, R, V2, td, ancho, t_fin, h (0 = automático)
 *   FL_RL   A, f, R, L, t_fin, h            (cuadrada 0/2A: nivel = A, ciclo 50)
 *   FL_RLC  R, L, C, V2, td, ancho, t_fin, h (E ideal de pulso, R, L y C en serie)
 *   FL_BIB  el índice del modelo y sus valores (para comprobar que la exacta es de él)
 *   FL_NET  el paso (0 = automático; el BJT con h/2 y h/4 del de hoy, 23 us, fijos)
 *   FL_ESC  tramos, r, C0, f, t_fin, h      (la escalera del juez: cuadrada 0/5 V)
 *   FL_IMP  como FL_RC, con la E ideal, un C1 de 1 uF encima (un impulso en
 *           cada flanco) y r como una R aparte: la exacta de C2, la del RC */
typedef struct {
    const char *nom;
    int    grupo;                       /* el punto (1 a 6) de la lista de arriba */
    int    tipo;
    double par[8];
    const char *net;                    /* FL_NET: la red en CESNET 3 (la del oráculo) */
    const char *canales;
    FlExacta ex;
} FlCaso;

