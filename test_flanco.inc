/* ---- La exacta en t (lado -1: el límite por la izquierda) ---- */
static int fl_pieza(const FlExacta *x, double t, int lado, double tol)
{
    int lo = 0, hi = x->np - 1;               /* la última con ta <= t (o ta < t por la izquierda) */
    while (lo < hi) {
        int m = (lo + hi + 1) / 2;
        double ta = x->p[m].ta;
        if (lado > 0 ? ta <= t + tol : ta < t - tol) lo = m; else hi = m - 1;
    }
    return lo;
}

static double fl_exacta(const FlExacta *x, int ch, double t, int lado, double tol)
{
    const FlPieza *p = &x->p[fl_pieza(x, t, lado, tol)];
    if (p->nm >= 0) {
        double u = t - (p->ta > 0.0 ? p->ta : 0.0), y = p->c0[ch];
        int k;
        for (k = 0; k < p->nm; k++)
            y += exp(p->re[k] * u) * (p->A[ch][k] * cos(p->im[k] * u) + p->B[ch][k] * sin(p->im[k] * u));
        return y;
    } else {                                  /* tabulada: la cúbica de 4 puntos de su pieza */
        const double (*q)[3] = x->pt + p->i0;
        int n = p->np, lo = 0, hi = n - 1, a, i, m;
        double y = 0.0;
        if (t <= q[0][0]) return q[0][1 + ch];
        if (t >= q[n - 1][0]) return q[n - 1][1 + ch];
        while (hi - lo > 1) { m = (lo + hi) / 2; if (q[m][0] <= t) lo = m; else hi = m; }
        a = lo - 1;
        if (a > n - 4) a = n - 4;
        if (a < 0) a = 0;
        for (i = a; i < a + 4 && i < n; i++) {
            double c = 1.0;
            for (m = a; m < a + 4 && m < n; m++) if (m != i) c *= (t - q[m][0]) / (q[i][0] - q[m][0]);
            y += c * q[i][1 + ch];
        }
        return y;
    }
}

