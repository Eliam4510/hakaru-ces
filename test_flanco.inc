/* ---- Los criterios que se proponen para un arreglo ----
 * Un caso es RÍGIDO si algún flanco tiene un modo con tau < FL_RIGIDO·h (la
 * menor tau/h de sus flancos, con el h de la corrida). En los rígidos: la y+
 * a FL_TOL_YMAS de la escala, cada muestra de después (en [te, te + 5·tau] y
 * fuera) a FL_TOL_TRAS, y pasos y operaciones como mucho FL_COSTO veces los
 * de hoy. En los demás: la huella de hoy (bit a bit) y como mucho FL_COSTO_NR
 * veces las operaciones (una comprobación por flanco, nada más).
 * Por qué 5·h (1er orden, relativo al salto): el arranque de hoy deja en te + h
 * 2,6e-2 con tau/h 0,3; 2,2e-2 con 1; 4,9e-3 con 3; 2,0e-3 con 5; 8,5e-4 con
 * 8 y 5,6e-4 con 10. Y el trapecio solo, aunque arrancara exacto en te + h,
 * deja 1,0e-2 (0,3), 1,3e-2 (1), 2,5e-3 (3) y 1,0e-3 (5): un arreglo que
 * cumpla tiene que seguir con pasos cortos hasta te + 2h (0,3) o te + 4h (1 y
 * 3). El banco no tiene casos entre 3h y 10h: un arreglo que actúe con tau <
 * 8h no deja nada por encima de 1e-3 con el arranque de hoy. */
#define FL_RIGIDO    5.0
#define FL_TOL_YMAS  1e-3
#define FL_TOL_TRAS  1e-3
#define FL_COSTO     1.5
#define FL_COSTO_NR  1.05
/* El balance (el juez, prueba b): la diferencia del balance, a 2e-4 de lo
 * entregado. Con el trapecio entre las muestras registradas y la y+
 * consistente, el pico de un modo con tau << h contaba un triángulo de h/2
 * (el mínimo con 7e-4); con los pesos de las etapas de SDIRK2 también en los
 * productos, 1e-4 en el mínimo pero −1,1e-2 en el RC de tau = h/100 y −4,7e-2
 * en la escalera de r = 1 ohm (lo que disipa un modo que se apaga dentro de
 * una etapa no lo veía ninguna R); con la media de los extremos por la
 * integral del método (rq_suma), sin L es exacto: 1e-7 o menos. En «imp C» la
 * diferencia es la del impulso de verdad (C1 sobre la E ideal), y no se mide. */
#define FL_TOL_BAL   2e-4
#define FL_NBAL      4
static const char *const FL_BAL_CASOS[FL_NBAL] = { "minimo", "RL cuadrada", "RC tau/h=0,01", "esc14_1k_r1" };
